{
  "name": "garimpo",
  "productName": "Garimpo",
  "version": "1.3.0",
  "description": "App de desktop que garimpa artistas novos a partir do que você ouve no Spotify e no Last.fm.",
  "desktopName": "garimpo.desktop",
  "author": "Renan",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --require ./test/ajuda/electron-falso.js --test test/",
    "icone": "electron scripts/gerar-icone.js",
    "instalador": "electron-builder --win nsis --publish never",
    "instalador:linux": "electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "app.garimpo.desktop",
    "productName": "Garimpo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Garimpo",
      "runAfterFinish": false,
      "artifactName": "Garimpo-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Audio",
      "artifactName": "Garimpo-${version}.${ext}",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lobbyboya",
        "repo": "garimpo"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
