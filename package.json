{
  "name": "garimpo",
  "productName": "Garimpo",
  "version": "1.3.0",
  "description": "App de desktop que garimpa artistas novos a partir do que você ouve no Spotify e no Last.fm.",
  "author": "Renan",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icone": "electron scripts/gerar-icone.js",
    "instalador": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.garimpo.desktop",
    "productName": "Garimpo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Garimpo",
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
