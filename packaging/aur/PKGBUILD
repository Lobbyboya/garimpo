# Maintainer: Renan <seu-email at exemplo dot com>
#
# Pacote do AUR que instala o Garimpo a partir do AppImage publicado nas releases do GitHub.
# O AppImage é só extraído (não precisa de FUSE) e o app roda com o sandbox do Electron ligado.
# Para uma versão nova: troque pkgver, zere pkgrel=1, rode `updpkgsums` e `makepkg --printsrcinfo > .SRCINFO`.

pkgname=garimpo-bin
_nome=Garimpo
pkgver=1.3.0
pkgrel=1
pkgdesc="Descubra artistas novos a partir do que você ouve no Spotify, no Last.fm ou numa lista"
arch=('x86_64')
url="https://github.com/Lobbyboya/garimpo"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libsecret')
provides=('garimpo')
conflicts=('garimpo')
options=('!strip' '!debug')
source=("${_nome}-${pkgver}.AppImage::${url}/releases/download/v${pkgver}/${_nome}-${pkgver}.AppImage"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Lobbyboya/garimpo/v${pkgver}/LICENSE"
        "garimpo.desktop")
noextract=("${_nome}-${pkgver}.AppImage")
sha256sums=('4c0ff075c14b53fe4a81d0543e85b6ed4534bed69f4187d4830d31e0b6647f5e'
            '83c14493af1225f43da59692a17161c565f6ce347bc98c2ee1c4e022345c4dcd'
            '7efb1da61f353efca51ea3924999bd57a720ada54ba201e1339aa28d6a485aec')

prepare() {
  chmod +x "${_nome}-${pkgver}.AppImage"
  rm -rf squashfs-root
  "./${_nome}-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  install -d "${pkgdir}/opt/garimpo"
  cp -a squashfs-root/. "${pkgdir}/opt/garimpo/"
  # Arquivos que só fazem sentido dentro do AppImage
  rm -rf "${pkgdir}/opt/garimpo/"{AppRun,garimpo.desktop,garimpo.png,.DirIcon,usr}
  chmod -R u+rwX,go+rX,go-w "${pkgdir}/opt/garimpo"
  chmod 4755 "${pkgdir}/opt/garimpo/chrome-sandbox" # sandbox do Chromium (o AppImage roda sem ele)

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/garimpo/garimpo "${pkgdir}/usr/bin/garimpo"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/512x512/apps/garimpo.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/garimpo.png"
  install -Dm644 garimpo.desktop "${pkgdir}/usr/share/applications/garimpo.desktop"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
